{
  "schemaVersion": "1.0",
  "projectId": "juss-beautiful-hair",
  "repository": {
    "provider": "github",
    "identifier": "jussray/jussbeautifulhair-site",
    "defaultBranch": "main"
  },
  "verification": {
    "requiredSignals": [
      {
        "id": "typecheck",
        "name": "Typecheck",
        "required": true
      }
    ]
  },
  "capabilities": [
    {
      "id": "public-storefront-routing",
      "description": "Serves the public shopping, product, cart, checkout, informational, and success routes.",
      "status": "active",
      "evidencePaths": [
        "client/src/App.tsx",
        "client/src/pages/Home.tsx",
        "client/src/pages/Shop.tsx",
        "client/src/pages/Product.tsx",
        "client/src/pages/Cart.tsx",
        "client/src/pages/Checkout.tsx"
      ],
      "requiredSignals": [
        "typecheck"
      ],
      "usageAssertions": [
        {
          "id": "app-mounts-shop-route",
          "path": "client/src/App.tsx",
          "marker": "<Route path=\"/shop\" component={Shop} />",
          "description": "The public router mounts the shopping catalog."
        },
        {
          "id": "app-mounts-cart-route",
          "path": "client/src/App.tsx",
          "marker": "<Route path=\"/cart\" component={Cart} />",
          "description": "The public router mounts the cart flow."
        },
        {
          "id": "app-mounts-checkout-route",
          "path": "client/src/App.tsx",
          "marker": "<Route path=\"/checkout\" component={Checkout} />",
          "description": "The public router mounts the checkout review page."
        },
        {
          "id": "app-wraps-routes-in-cart-provider",
          "path": "client/src/App.tsx",
          "marker": "<CartProvider>",
          "description": "Shopping routes share the active cart state provider."
        }
      ]
    },
    {
      "id": "server-authoritative-stripe-checkout",
      "description": "Accepts catalog IDs and quantities, resolves prices server-side, restricts origins, and creates Stripe-hosted checkout sessions without exposing secret keys.",
      "status": "active",
      "evidencePaths": [
        "worker/index.ts",
        "client/src/lib/catalog.ts",
        "client/src/pages/Checkout.tsx",
        "wrangler.toml"
      ],
      "requiredSignals": [
        "typecheck"
      ],
      "usageAssertions": [
        {
          "id": "checkout-page-posts-catalog-identifiers",
          "path": "client/src/pages/Checkout.tsx",
          "marker": "fetch(\"/api/checkout\"",
          "description": "The browser submits only catalog IDs, variants, quantities, and an attempt ID."
        },
        {
          "id": "worker-routes-checkout-api",
          "path": "worker/index.ts",
          "marker": "url.pathname === \"/api/checkout\"",
          "description": "The Cloudflare Worker routes checkout requests to the server handler."
        },
        {
          "id": "worker-resolves-canonical-products",
          "path": "worker/index.ts",
          "marker": "getProduct(requested.id)",
          "description": "Prices and product details are resolved from the server-owned catalog."
        },
        {
          "id": "worker-enforces-origin-allowlist",
          "path": "worker/index.ts",
          "marker": "allowedOrigins.includes(origin)",
          "description": "Checkout refuses browser origins outside the configured storefront allowlist."
        },
        {
          "id": "worker-creates-idempotent-stripe-session",
          "path": "worker/index.ts",
          "marker": "idempotencyKey: `jbh-checkout-${reference}`",
          "description": "Stripe session creation is tied to the client-generated checkout attempt ID."
        }
      ]
    },
    {
      "id": "public-private-source-boundary",
      "description": "Keeps private admin, vendor sourcing, customer exports, and owner controls outside the public storefront repository.",
      "status": "active",
      "evidencePaths": [
        "README.md",
        "LICENSE",
        ".gitignore",
        "client/src/App.tsx"
      ],
      "requiredSignals": [
        "typecheck"
      ],
      "usageAssertions": [
        {
          "id": "public-router-has-no-admin-import",
          "path": "client/src/App.tsx",
          "marker": "It lives in a separate local-only build",
          "description": "The public router documents and preserves the local-only admin boundary."
        },
        {
          "id": "checkout-states-no-public-customer-credentials",
          "path": "client/src/pages/Checkout.tsx",
          "marker": "does not place payment credentials or customer",
          "description": "The public checkout surface states that Stripe collects sensitive payment/contact fields."
        }
      ]
    },
    {
      "id": "cloudflare-storefront-deployment",
      "description": "Builds static Vite assets and deploys them with the checkout Worker through Cloudflare.",
      "status": "active",
      "evidencePaths": [
        "package.json",
        "vite.config.ts",
        "wrangler.toml",
        "worker/index.ts"
      ],
      "requiredSignals": [
        "typecheck"
      ],
      "usageAssertions": [
        {
          "id": "package-builds-vite-assets",
          "path": "package.json",
          "marker": "\"build\": \"vite build\"",
          "description": "The repository build produces the static storefront bundle."
        },
        {
          "id": "wrangler-points-to-checkout-worker",
          "path": "wrangler.toml",
          "marker": "main = \"worker/index.ts\"",
          "description": "Cloudflare executes the Worker containing the checkout route."
        },
        {
          "id": "wrangler-binds-static-assets",
          "path": "wrangler.toml",
          "marker": "binding = \"ASSETS\"",
          "description": "The Worker is configured to serve the built public assets."
        },
        {
          "id": "wrangler-runs-worker-for-api",
          "path": "wrangler.toml",
          "marker": "run_worker_first = [\"/api/*\"]",
          "description": "API requests reach the Worker before static asset handling."
        }
      ]
    },
    {
      "id": "checkout-regression-suite",
      "description": "Automated negative-origin, invalid-catalog, idempotency, cart, checkout, and success-flow tests.",
      "status": "planned",
      "evidencePaths": [],
      "requiredSignals": [],
      "usageAssertions": []
    },
    {
      "id": "storefront-lint-and-unit-suite",
      "description": "Executable lint and unit-test scripts matching the repository Quality Gate workflow.",
      "status": "planned",
      "evidencePaths": [],
      "requiredSignals": [],
      "usageAssertions": []
    }
  ],
  "buildAssist": {
    "enabled": true,
    "preferredBuilder": "codex",
    "riskLevel": "high"
  },
  "privacy": {
    "allowlistedPacketFields": [
      "projectId",
      "repository.provider",
      "repository.identifier",
      "commitSha",
      "branch",
      "manifestHash",
      "generatedAt",
      "runner.provider",
      "runner.runId",
      "runner.detailsUrl",
      "checks.id",
      "checks.name",
      "checks.required",
      "checks.status",
      "checks.detailsUrl",
      "capabilities.id",
      "capabilities.claimedStatus",
      "capabilities.observedStatus",
      "capabilities.evidencePaths",
      "capabilities.usageAssertionIds",
      "capabilities.failedUsageAssertionIds",
      "capabilities.reason"
    ],
    "forbiddenData": [
      "Stripe secret keys",
      "Stripe webhook secrets",
      "Cloudflare API tokens",
      "customer names or contact information",
      "shipping or billing addresses",
      "order exports",
      "vendor identities or sourcing records",
      "private admin source",
      "factory pricing",
      "payment card data",
      "usage assertion marker text in runner packets"
    ]
  }
}
